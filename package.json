{
  "name": "@forever-lwy/dsh-google-native",
  "version": "0.1.13",
  "description": "Native Google Gemini AI Studio and Vertex AI provider for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "examples",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forever-lwy/dsh-google-native.git"
  },
  "engines": {
    "node": ">=22",
    "dsh": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "prepare": "npm run build",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "undici": "7.18.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/cordis-plugin-loader": ">=1.0.6 <2.0.0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-attachment": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-session-query": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-executor-ptc": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": ">=0.2.1-rc.5",
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-modules": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.25.12",
    "immer": "10.1.1",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~5.9.3",
    "zustand": "4.5.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  }
}
